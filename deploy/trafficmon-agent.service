[Unit]
Description=Observatory VPS monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trafficagent
Group=trafficagent
ExecStart=/usr/local/bin/traffic-agent run --config /etc/trafficmon/agent.json
StateDirectory=trafficmon-agent
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/trafficmon /var/lib/trafficmon-agent
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
